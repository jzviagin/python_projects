{
  "manifest_version": 3,
  "name": "WA Sender",
  "version": "1.0",
  "description": "Fill a templated message for a phone number inside the open WhatsApp Web window.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["phone.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
